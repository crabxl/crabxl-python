# Private native module: the classes behind the public crabxl API. The
# openpyxl adapter's helpers are not part of this stub.
from collections.abc import Iterable

from ._values import CellInput, Value
from .styles import PartialStyle, Style

class ApiWorkbook:
    @staticmethod
    def create(serial_dates: bool) -> ApiWorkbook: ...
    @staticmethod
    def open_path(
        path: str,
        limits: str,
        memory: int | None,
        data_loss: str,
        exact_numbers: bool,
        serial_dates: bool,
    ) -> ApiWorkbook: ...
    @staticmethod
    def open_bytes(
        data: bytes | None,
        limits: str,
        memory: int | None,
        data_loss: str,
        exact_numbers: bool,
        serial_dates: bool,
    ) -> ApiWorkbook: ...
    def close(self) -> None: ...
    def is_closed(self) -> bool: ...
    def save_path(
        self, path: str, compression: int | None, recalculate: bool
    ) -> None: ...
    def save_bytes(self, compression: int | None, recalculate: bool) -> bytes: ...
    def calculate(self) -> None: ...
    def sheet_names(self) -> list[str]: ...
    def worksheet_names(self) -> list[str]: ...
    def add_worksheet(self, name: str, index: int | None) -> str: ...
    def copy_worksheet(self, source: str, name: str) -> str: ...
    def remove_sheet(self, name: str) -> None: ...
    def move_sheet(self, name: str, index: int) -> None: ...
    def rename_sheet(self, name: str, new: str) -> None: ...
    def active_sheet(self) -> str | None: ...
    def set_active_sheet(self, name: str) -> None: ...
    def visibility(self, name: str) -> str: ...
    def set_visibility(self, name: str, visibility: str) -> None: ...
    def value(self, sheet: str, cell: str) -> Value: ...
    def values(self, sheet: str, range: str) -> tuple[tuple[Value, ...], ...]: ...
    def formula(self, sheet: str, cell: str) -> str | None: ...
    def set_value(self, sheet: str, cell: str, value: CellInput) -> None: ...
    def fill(self, sheet: str, range: str, value: CellInput) -> None: ...
    def set_values(
        self, sheet: str, range: str, rows: Iterable[Iterable[CellInput]]
    ) -> None: ...
    def append_rows(
        self,
        sheet: str,
        rows: Iterable[Iterable[CellInput]],
        style: Style | None = None,
    ) -> None: ...
    def clear(self, sheet: str, range: str) -> None: ...
    def used_range(self, sheet: str) -> str | None: ...
    def style(self, sheet: str, cell: str) -> Style: ...
    def set_style(self, sheet: str, range: str, style: Style) -> None: ...
    def column_width(self, sheet: str, column: str) -> float | None: ...
    def set_column_width(self, sheet: str, columns: str, width: float) -> None: ...
    def set_columns_hidden(self, sheet: str, columns: str, hidden: bool) -> None: ...
    def row_height(self, sheet: str, row: str) -> float | None: ...
    def set_row_height(self, sheet: str, rows: str, height: float) -> None: ...
    def set_rows_hidden(self, sheet: str, rows: str, hidden: bool) -> None: ...
    def frozen_panes(self, sheet: str) -> str | None: ...
    def freeze_panes(self, sheet: str, cell: str | None) -> None: ...
    def insert_rows(self, sheet: str, rows: str) -> None: ...
    def delete_rows(self, sheet: str, rows: str) -> None: ...
    def insert_columns(self, sheet: str, columns: str) -> None: ...
    def delete_columns(self, sheet: str, columns: str) -> None: ...
    def merge(self, sheet: str, range: str) -> None: ...
    def unmerge(self, sheet: str, range: str) -> None: ...
    def merged_ranges(self, sheet: str) -> list[str]: ...
    def tables(self, sheet: str) -> list[tuple[str, str, str | None, bool, bool]]: ...
    def add_table(
        self,
        sheet: str,
        name: str,
        range: str,
        style: str | None,
        banded_rows: bool,
        totals_row: bool,
    ) -> None: ...
    def remove_table(self, sheet: str, name: str) -> None: ...
    def validations(
        self, sheet: str
    ) -> list[
        tuple[
            str,
            list[str],
            str | None,
            str | None,
            str | None,
            bool,
            tuple[str, str] | None,
            tuple[str, str] | None,
        ]
    ]: ...
    def add_validation(
        self,
        sheet: str,
        kind: str,
        ranges: list[str],
        first: object,
        second: object = None,
        comparison: str | None = None,
        allow_blank: bool = True,
        prompt: tuple[str, str] | None = None,
        error_message: tuple[str, str] | None = None,
    ) -> None: ...
    def remove_validations(self, sheet: str, range: str) -> int: ...
    def conditional_formats(
        self, sheet: str
    ) -> list[
        tuple[list[str], str, list[str], str | None, PartialStyle | None, bool]
    ]: ...
    def add_conditional_format(
        self,
        sheet: str,
        ranges: list[str],
        kind: str,
        style: PartialStyle,
        formula: str,
        second: str | None = None,
        comparison: str | None = None,
        stop_if_true: bool = False,
    ) -> None: ...
    def note(self, sheet: str, cell: str) -> tuple[str, str] | None: ...
    def set_note(self, sheet: str, cell: str, text: str, author: str) -> None: ...
    def remove_note(self, sheet: str, cell: str) -> bool: ...
    def hyperlink(
        self, sheet: str, cell: str
    ) -> tuple[str, str, str | None] | None: ...
    def set_hyperlink(
        self, sheet: str, cell: str, kind: str, target: str, tooltip: str | None
    ) -> None: ...
    def remove_hyperlink(self, sheet: str, cell: str) -> None: ...
    def add_image(self, sheet: str, data: bytes, cell: str) -> None: ...
    def image_count(self, sheet: str) -> int: ...
    def protect(self, sheet: str, password: str | None) -> None: ...
    def unprotect(self, sheet: str) -> None: ...
    def is_protected(self, sheet: str) -> bool: ...
    def defined_names(self) -> list[tuple[str, str, str | None]]: ...
    def add_defined_name(self, name: str, formula: str, sheet: str | None) -> None: ...
    def remove_defined_name(self, name: str) -> None: ...
    def properties(self) -> dict[str, str | None]: ...
    def set_properties(self, values: dict[str, str | None]) -> None: ...
    def modes(self) -> tuple[bool, bool]: ...

class ApiRowStream:
    def next_batch(
        self,
    ) -> list[tuple[int, tuple[Value, ...], tuple[str | None, ...] | None]] | None: ...
    def close(self) -> None: ...

class ApiReader:
    @staticmethod
    def open(
        path: str | None,
        data: bytes | None,
        limits: str,
        exact_numbers: bool,
        serial_dates: bool,
    ) -> ApiReader: ...
    def sheet_names(self) -> list[str]: ...
    def rows(
        self,
        sheet: str,
        columns: str | None = None,
        skip: int = 0,
        limit: int | None = None,
        batch: int = 1024,
    ) -> ApiRowStream: ...

class ApiWriter:
    @staticmethod
    def create(
        path: str | None,
        compression: int | None = None,
        temp_directory: str | None = None,
    ) -> ApiWriter: ...
    def add_worksheet(self, name: str) -> None: ...
    def append_rows(
        self,
        sheet: str,
        rows: Iterable[Iterable[CellInput]],
        style: Style | None = None,
    ) -> None: ...
    def skip_rows(self, sheet: str, count: int) -> None: ...
    def set_column_width(self, sheet: str, columns: str, width: float) -> None: ...
    def freeze_panes(self, sheet: str, cell: str) -> None: ...
    def merge(self, sheet: str, range: str) -> None: ...
    def add_validation(
        self, sheet: str, choices: list[str], ranges: list[str]
    ) -> None: ...
    def add_formula_format(
        self, sheet: str, ranges: list[str], formula: str, style: PartialStyle
    ) -> None: ...
    def finish(self) -> None: ...
    def finish_bytes(self) -> bytes: ...
    def abort(self) -> None: ...
